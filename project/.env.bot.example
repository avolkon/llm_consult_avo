# Bot service example.
# Copy this file to .env.bot for local Docker runs and fill real secrets there.
# Do not put real tokens into this example file.
APP_NAME=bot-service
ENV=local
MAX_BOT_TOKEN=
# Тот же секрет, что auth_service; >= 32 символов; не change_me / replace-with-secret-matching-auth-service
JWT_SECRET=local_development_matching_auth_32_chars_min
JWT_ALG=HS256
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=stepfun/step-3.5-flash:free
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=bot-service
OPENROUTER_TIMEOUT_SECONDS=60
API_HOST=0.0.0.0
API_PORT=8080
# Максимальный размер тела запроса (байт), по заголовку Content-Length
MAX_REQUEST_BODY_BYTES=1048576
WEBHOOK_PATH=/webhook
MAX_DELIVERY_MODE=webhook
OUTBOX_DEDUP_ENABLED=false
OUTBOX_DEDUP_TTL_SECONDS=3600
OUTBOX_SEND_MAX_RETRIES=3
