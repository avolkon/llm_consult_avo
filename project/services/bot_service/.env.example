# Токен бота MAX (кабинет разработчика https://dev.max.ru/)
MAX_BOT_TOKEN=

ENV=local

# Тот же секрет, что и в auth_service (HS256). Минимум 32 символа, не плейсхолдеры change_me / replace-with-secret-matching-auth-service.
JWT_SECRET=local_development_matching_auth_32_chars_min
JWT_ALG=HS256
# JWT_AUDIENCE=llm-consult

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# В ENV=prod|production обязательны rediss:// и amqps:// (TLS); для самоподписанного CA задайте пути:
# REDIS_SSL_CA_CERTS=/run/tls/ca.crt
# CELERY_BROKER_CA_CERT=/run/tls/ca.crt

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=stepfun/step-3.5-flash:free
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=bot-service
OPENROUTER_TIMEOUT_SECONDS=60

API_HOST=0.0.0.0
API_PORT=8080
WEBHOOK_PATH=/webhook

# polling — long polling (dev); webhook — только для max-webhook + открытый HTTPS URL в MAX
MAX_DELIVERY_MODE=polling

# Опциональная дедупликация outbox по task_id (для production/ретраев)
OUTBOX_DEDUP_ENABLED=false
OUTBOX_DEDUP_TTL_SECONDS=3600
OUTBOX_SEND_MAX_RETRIES=3

# Логирование фрагментов промпта (handlers): в local по умолчанию true; в prod/production — false, если переменная не задана.
LOG_PROMPT_CONTENT=true

# --- Защита в глубину (production): одинаковое значение в процессах bot webhook и Celery worker ---
# Подпись max_auth:* и элементов max:outbox в Redis (атакующий без секрета не сможет подставить сессию/сообщение).
# REDIS_INTEGRITY_SECRET=

# --- Webhook MAX: доп. слой до maxapi (секрет часто подставляет reverse proxy в заголовок; см. ИБ_webhook) ---
# WEBHOOK_REQUEST_SECRET=
# WEBHOOK_REQUEST_HEADER=x-webhook-secret
# WEBHOOK_ALLOWED_CIDRS=203.0.113.0/24
# Если webhook за nginx/traefik с X-Forwarded-For: 1 (только если доверяете первому хопу).
# WEBHOOK_FORWARDED_FOR_TRUST_HOPS=0
