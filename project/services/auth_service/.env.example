APP_NAME=auth-service
ENV=local

JWT_SECRET=change_me_super_secret
JWT_ALG=HS256
# Опционально: одинаковое значение в bot_service → claim aud в JWT
# JWT_AUDIENCE=llm-consult
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=sqlite+aiosqlite:///./auth.db

API_HOST=0.0.0.0
API_PORT=8000

# Максимальный размер тела запроса (байт), по заголовку Content-Length
MAX_REQUEST_BODY_BYTES=1048576

# За reverse proxy: доверять X-Forwarded-For для rate limit (только если прокси ваш)
# TRUSTED_PROXY_HEADERS=false
